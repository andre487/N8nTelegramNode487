{
  "name": "n8n-nodes-telegram487",
  "version": "0.1.0",
  "description": "Send Telegram photo albums from n8n binary data using an existing Telegram credential.",
  "license": "MIT",
  "author": "Andrey Prokopyuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andre487/N8nTelegramNode487.git"
  },
